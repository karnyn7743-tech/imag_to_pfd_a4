<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- ============================================================ -->
    <!-- === الإعداد الافتراضي: منع كل الاتصالات غير المشفرة ===      -->
    <!-- ============================================================ -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- نثق فقط بشهادات النظام الرسمية -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- ============================================================ -->
    <!-- === استثناءات الشبكة المحلية (LAN) ===                        -->
    <!-- نسمح بـ Cleartext فقط على الشبكات المحلية الخاصة           -->
    <!-- ============================================================ -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- نطاقات IPv4 المحلية -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>

        <!-- شبكة 192.168.x.x -->
        <domain includeSubdomains="true">192.168.0.0</domain>

        <!-- شبكة 10.x.x.x -->
        <domain includeSubdomains="true">10.0.0.0</domain>

        <!-- شبكة 172.16-31.x.x -->
        <domain includeSubdomains="true">172.16.0.0</domain>

        <!-- أسماء mDNS المحلية -->
        <domain includeSubdomains="true">local</domain>
    </domain-config>

    <!-- ============================================================ -->
    <!-- === استثناء خاص: نطاقات البث المتعدد ===                     -->
    <!-- (لا يمكن تحديدها كـ domain، لكن نضيفها هنا للتوثيق) ===     -->
    <!-- ============================================================ -->
    <!--
        255.255.255.255  → Broadcast
        239.255.42.99    → Multicast (الذي نستخدمه)
        يتم التعامل معها تلقائيًا ضمن الإعداد أعلاه
    -->

    <!-- ============================================================ -->
    <!-- === نطاقات مخصصة للتطوير فقط (احذفها في الإنتاج) ===         -->
    <!-- ============================================================ -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- افتراضيًا: كل عناوين الشبكة المحلية مسموحة -->
        <domain includeSubdomains="true">0.0.0.0</domain>
    </domain-config>

</network-security-config>
